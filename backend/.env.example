ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://recruiter:recruiter@localhost:5432/recruiter
# Generate secrets with python scripts/setup_local.py. Never use example secrets.
SIGNING_KEY=
ENCRYPTION_KEY=
DEV_AUTH_ENABLED=false
DEV_LOGIN_PASSWORD=
CANDIDATE_PORTAL_URL=http://localhost:5175
CONVERSATION_WORKER_ENABLED=true
AI_WORKER_ENABLED=false
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_DOCKER_BASE_URL=http://host.docker.internal:8080/v1
DIFY_API_KEYS={}
AI_TIMEOUT_SECONDS=45
# Only used by the local Dify provisioning script, never sent to recruiter browsers.
DEEPSEEK_API_KEY=
