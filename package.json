{
  "name": "ai-recruiter",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:hr": "pnpm --filter @recruiter/hr-web dev",
    "dev:biz": "pnpm --filter @recruiter/biz-h5 dev",
    "dev:candidate": "pnpm --filter @recruiter/candidate-h5 dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint frontend",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "type": "module"
}
